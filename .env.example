# Copy to .env for local runs. In production these live in Dokploy → scout-bot → Environment.
BOT_TOKEN=
# webhook (default, via bots.rabbia.net) or polling (no public domain needed)
TELEGRAM_MODE=webhook
WEBHOOK_URL=https://bots.rabbia.net/scoutbot
PORT=8000
TELEGRAM_ALLOWED_CHAT_ID=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
IG_PROVIDER=apify
APIFY_TOKEN=
EVENTBRITE_TOKEN=
GCAL_SA_JSON=
GCAL_CALENDAR_ID=
TZ=Europe/Madrid
DATA_DIR=/data
# Optional
# POLL_HOURS=8,11,14,17,20,23   (Madrid time; default every 3 h from 08:00 to 23:00)
# APIFY_MONTHLY_BUDGET_USD=5
# REGION_FILTER=madrid           (madrid | all)
# SEED_ACCOUNTS=mercadillosencasa,arquitecturadelorden,almamarket_home,thecircularmarket.es,homemarket_lmh,my_market_mad
# GDRIVE_FOLDER_ID=               (Shared Drive folder for ticket QRs attached to calendar entries; see README)
# GOOGLE_SCOPES=calendar.events drive.file
# RETENTION_DAYS=14               (delete events this many days after they end)
# GEMINI_RPM=12                   (Gemini calls per minute; free tier allows 15. Raise if you enable billing)
# TICKET_HUNT_MINUTES=5             (/hunt check interval; default 5 with EVENTBRITE_TOKEN, 10 without)
# GOOGLE_OAUTH_CLIENT_ID=           (/google: OAuth client 'TVs and Limited Input devices'; see README)
# GOOGLE_OAUTH_CLIENT_SECRET=
